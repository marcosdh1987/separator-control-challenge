  "datasetDescriptions": {
    "control-c2-water-replication-20261115": "Campaign C2 on LIC-103 (confirmatory, pre-registered): one SIMC design with a 10 s PV filter against the deployed PID on eight scenarios, new seeds 7200-7202, criteria frozen before the runs.",
    "control-c2-lag-followup-20261116": "C2 robustness follow-up (exploratory): LCV-102 actuator lag 20 s under M6 B and c2simc over a 4 h hold, to tell a damped oscillation from a slowly diverging one.",
    "control-c2-robustness-e-pilot-20261116": "C2 designs under perturbations (exploratory): c2simc against the deployed PID and M6 B under water-cut and reservoir-pressure steps, valve stiction and actuator lags, 1 h hold, three scenarios, seed 7100.",
    "nominal-pilot-20261113T234459Z": "Stage-1 operating-envelope pilot of the nominal plant: centre point, one-factor-at-a-time sweeps and a seeded Latin hypercube over nine boundary conditions, one seed."
  },
  "allowedReferences": [
    "Skogestad S. (2003) Simple analytic rules for model reduction and PID controller tuning. J. Process Control 13, 291-309",
    "Choudhury M.A.A.S., Shah S.L., Thornhill N.F. (2005) Modelling valve stiction. Control Eng. Practice 13(5), 641-658"
  ],
  "verbatimFields": [
    "evidence.modelUncertainties"
  ],
  "signalDescriptionOverrides": {
    "well.nodal_status": "dynamic nodal coupling status (1 CONVERGED)",
    "well.no_flow_reason": "dynamic nodal coupling: why the well delivers no flow"
  },
  "withheld": [
    {
      "field": "manifest.config.raw, config.resolved.baseline, config.resolved.baseline_provenance",
      "reason": "Verbatim campaign YAML with the baseline boundary conditions and their provenance notes; only its SHA-256 is published."
    },
    {
      "field": "run.load_plan, run.prescreen, protocol.load.readback",
      "reason": "Register-level load plan of the virtual PLC; not needed to read a result."
    },
    {
      "field": "factors: oil_api_gravity, salinity_ppm, wellhead_temperature_c, reservoir_temperature_c, tubing_*",
      "reason": "Fluid and completion values of the field-derived centre point; not needed by the viewer."
    },
    {
      "field": "provenance.packages, provenance.platform, provenance.python",
      "reason": "Workstation details."
    },
    {
      "field": "provenance.source_sha256",
      "reason": "Per-file hash map of a private code base; replaced by one digest of the map."
    },
    {
      "field": "provenance.git_dirty",
      "reason": "File names of uncommitted changes; replaced by their count."
    },
    {
      "field": "run.cpu, run.wall_seconds",
      "reason": "Host timing, not a result."
    },
    {
      "field": "trace columns not listed in signals",
      "reason": "Storage, metrology, nodal-solver internals and flow-iron columns are not needed by the replay."
    },
    {
      "field": "report.html, report.md, figures/",
      "reason": "The private report is not republished; the site re-derives every shown number from the run records."
    },
    {
      "field": "manifest.description, variant.basis, constraint catalogue basis",
      "reason": "Free text of a private code base (internal study labels, register ids, module and document paths); curated descriptions from this policy are published instead."
    },
    {
      "field": "variant references other than allowedReferences",
      "reason": "Internal file and decision-record paths; only literature citations are published."
    }
  ],
